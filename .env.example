# AIMScribe Backend - copy to .env and fill in.
#
# .env is gitignored. Never put real values in docker-compose.yml: the Neon
# password was hardcoded there and published to a public repository for three
# months before it was noticed.

# ================================================================
# PostgreSQL (Neon)
# ================================================================
POSTGRES_HOST=ep-xxxx-pooler.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ================================================================
# Azure OpenAI
# ================================================================
AZURE_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_API_KEY=
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe-diarize
AZURE_TRANSCRIBE_API_VERSION=2025-03-01-preview

AZURE_NER_ENDPOINT=
AZURE_NER_API_KEY=
AZURE_NER_DEPLOYMENT=gpt-5.2-chat
AZURE_API_VERSION=2025-01-01-preview

# ================================================================
# Object storage (local MinIO for development, R2 in production)
# ================================================================
MINIO_ACCESS_KEY=aimscribe
MINIO_SECRET_KEY=aimscribe123
MINIO_BUCKET=aimscribe-audio
MINIO_SECURE=false

# ================================================================
# Protocol 2
# ================================================================
# Admin endpoints (create hospitals, mint enrollment tokens, revoke devices).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIMS_ADMIN_KEY=

# The archive worker's credential. Must match AIMS_WORKER_KEY in
# archive_worker/.env
AIMS_WORKER_KEY=

# Ed25519 private key (PKCS#8 PEM) for signing purge receipts. Without it,
# audio is still received and archived but agents never delete their local
# copies - which is the safe failure direction.
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; k=K.generate(); print(k.private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
# In a .env file, put it on one line with \n escapes.
AIMS_RECEIPT_PRIVATE_KEY=

# Exact CMED origin(s). No wildcards.
AIMS_ALLOWED_ORIGINS=http://localhost:3000

# Must match AIMSCRIBE_WEBHOOK_SECRET in cmed-web.
# The old value was published in a public repo and must not be reused.
AIMSCRIBE_WEBHOOK_SECRET=

LOG_LEVEL=INFO
WORKER_CONCURRENCY=10
